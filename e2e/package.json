{
  "name": "docsage-e2e",
  "private": true,
  "description": "Playwright user-journey integration tests for DocSage. See e2e/README.md.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed:ui": "playwright test --ui-headed",
    "test:dotnet": "E2E_BACKEND=dotnet playwright test",
    "test:dotnet:headed": "E2E_BACKEND=dotnet playwright test --headed",
    "report": "playwright show-report",
    "fixtures": "cd ../backend && uv run python ../e2e/generate-fixtures.py --out ../e2e/fixtures"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0"
  }
}
