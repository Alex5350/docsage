# ---- Database (docker compose up db) ----
DOCSAGE_DATABASE_URL=postgresql+psycopg://docsage:docsage@localhost:5433/docsage

# ---- API ----
DOCSAGE_SESSION_SECRET=change-me-to-a-long-random-string
DOCSAGE_ENV=development
# When true (the default), providers stay off even if keys are set — flip to
# false once GEMINI_API_KEY / OPENAI_API_KEY are configured. See docs/providers.md.
DOCSAGE_DEMO_MODE=true

# ---- Embedding / chat providers (optional; unset = demo mode) ----
# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini embedding model — gemini-embedding-2 is natively multimodal (text/image/video/audio/PDF)
DOCSAGE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Gemini model used by the enrichment agent for image captioning / summaries
DOCSAGE_GEMINI_VISION_MODEL=gemini-2.5-flash
# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenAI embedding model
DOCSAGE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OpenAI chat model used for grounded answers (flagship gpt-5.6-sol, balanced gpt-5.6-terra, cost gpt-5.6-luna)
DOCSAGE_OPENAI_CHAT_MODEL=gpt-5.6-terra
# Base URL override for OpenAI-compatible endpoints (optional)
OPENAI_BASE_URL=

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
